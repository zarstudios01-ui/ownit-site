<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checkout | OwnIt</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#F2F1EC">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F2F1EC; --paper-dim:#E7E5DE; --ink:#151512; --ink-soft:#3A3A35;
  --graphite:#6E6E67; --line:#D4D2C8; --blood:#C4181A; --white:#FFFFFF;
  --display:'Bebas Neue',sans-serif; --body:'Inter',sans-serif; --mono:'JetBrains Mono',monospace;
  --maxw:1200px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{background:var(--paper);color:var(--ink);font-family:var(--body);line-height:1.5;-webkit-font-smoothing:antialiased;}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
h1,h2{font-family:var(--display);letter-spacing:.01em;line-height:.95;text-transform:uppercase;}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--blood);}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:15px 26px;border:1.5px solid var(--ink);width:100%;transition:all .15s ease;}
.btn-primary{background:var(--ink);color:var(--paper);}
.btn-primary:hover:not(:disabled){background:var(--blood);border-color:var(--blood);}
.btn-primary:disabled{opacity:.4;cursor:not-allowed;}
.btn-ghost{background:transparent;color:var(--ink);}
.btn-ghost:hover{background:var(--ink);color:var(--paper);}

/* Header */
.co-header{border-bottom:1px solid var(--line);padding:18px 0;}
.co-header-inner{display:flex;align-items:center;justify-content:space-between;}
.logo{font-family:var(--display);font-size:24px;letter-spacing:.04em;}
.logo span{color:var(--blood);}
.secure-tag{font-family:var(--mono);font-size:11px;color:var(--graphite);text-transform:uppercase;letter-spacing:.05em;display:flex;align-items:center;gap:6px;}
.secure-tag .dot{width:6px;height:6px;background:var(--blood);border-radius:50%;}

.steps{display:flex;gap:6px;font-family:var(--mono);font-size:11px;text-transform:uppercase;color:var(--graphite);padding:16px 0;letter-spacing:.05em;}
.steps span.current{color:var(--ink);font-weight:700;}
.steps span:not(:last-child)::after{content:"→";margin-left:6px;color:var(--line);}

/* Layout */
.co-main{padding:20px 0 90px;}
.co-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:52px;align-items:start;}
@media(max-width:900px){.co-grid{grid-template-columns:1fr;} .co-summary{order:-1;}}

.co-section{margin-bottom:34px;}
.co-section h2{font-size:22px;margin-bottom:16px;}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
.field{margin-bottom:12px;}
.field label{display:block;font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--graphite);margin-bottom:6px;}
.field input,.field select{
  width:100%;padding:12px 14px;border:1.5px solid var(--line);background:var(--white);
  font-family:var(--body);font-size:14px;color:var(--ink);
}
.field input:focus,.field select:focus{outline:none;border-color:var(--ink);}

.ship-option,.pay-note{border:1.5px solid var(--line);padding:14px 16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;cursor:pointer;}
.ship-option.active{border-color:var(--ink);}
.ship-option .so-name{font-weight:600;font-size:13.5px;}
.ship-option .so-time{font-family:var(--mono);font-size:11px;color:var(--graphite);}
.ship-option .so-price{font-family:var(--mono);font-size:13px;font-weight:700;}

.demo-banner{background:var(--paper-dim);border:1px dashed var(--line);padding:12px 16px;font-family:var(--mono);font-size:11.5px;color:var(--graphite);margin-bottom:26px;}
.demo-banner strong{color:var(--ink);}

/* Order summary */
.co-summary{background:var(--white);border:1px solid var(--line);padding:26px;position:sticky;top:24px;}
.co-summary h2{font-size:20px;margin-bottom:18px;}
.sum-item{display:grid;grid-template-columns:56px 1fr auto;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);align-items:center;}
.sum-item img{width:56px;height:56px;object-fit:cover;background:var(--paper-dim);border:1px solid var(--line);}
.sum-item-name{font-size:13px;font-weight:600;}
.sum-item-variant{font-size:11px;color:var(--graphite);margin-top:2px;}
.sum-item-qty{font-family:var(--mono);font-size:10.5px;color:var(--graphite);margin-top:4px;}
.sum-item-price{font-family:var(--mono);font-size:13px;font-weight:700;white-space:nowrap;}
.promo-row{display:flex;gap:8px;margin:18px 0;}
.promo-row input{flex:1;padding:11px 12px;border:1.5px solid var(--line);font-size:13px;}
.promo-row button{border:1.5px solid var(--ink);background:var(--white);padding:0 16px;font-family:var(--mono);font-size:11px;text-transform:uppercase;}
.cost-row{display:flex;justify-content:space-between;font-size:13.5px;padding:6px 0;color:var(--ink-soft);}
.cost-row.total{font-size:16px;font-weight:800;color:var(--ink);border-top:1px solid var(--line);margin-top:8px;padding-top:14px;}
.co-summary .btn{margin-top:20px;}
.empty-cart{text-align:center;padding:60px 0;}
.empty-cart h2{font-size:32px;margin-bottom:12px;}
.empty-cart p{color:var(--graphite);margin-bottom:24px;}
.empty-cart .btn{width:fit-content;margin:0 auto;padding-left:28px;padding-right:28px;}

/* Confirmation state */
.confirm-panel{display:none;text-align:center;padding:70px 24px;max-width:520px;margin:0 auto;}
.confirm-panel.show{display:block;}
.confirm-panel .check{width:56px;height:56px;border:1.5px solid var(--blood);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:24px;color:var(--blood);}
.confirm-panel h1{font-size:44px;margin-bottom:10px;}
.confirm-panel p{color:var(--ink-soft);margin-bottom:8px;}
.confirm-panel .order-id{font-family:var(--mono);font-size:12px;color:var(--graphite);margin-bottom:26px;}
.confirm-panel .demo-banner{text-align:left;margin-bottom:28px;}
.co-content.hidden{display:none;}
</style>
</head>
<body>

<header class="co-header">
  <div class="wrap co-header-inner">
    <a href="index.html" class="logo">Own<span>It</span></a>
    <span class="secure-tag"><span class="dot"></span>Secure Checkout</span>
  </div>
</header>

<main class="co-main wrap">
  <div class="steps">
    <span>Cart</span><span class="current">Checkout</span><span>Confirmation</span>
  </div>

  <div id="coContent" class="co-content">
    <div class="co-grid" id="coGrid">
      <!-- Left: form -->
      <div>
        <div class="demo-banner"><strong>Portfolio demo.</strong> This checkout collects nothing and no real payment is processed. It exists to show the full commerce flow.</div>

        <form id="checkoutForm">
          <section class="co-section">
            <h2>Contact</h2>
            <div class="field"><label for="email">Email</label><input type="email" id="email" required placeholder="you@example.com"></div>
          </section>

          <section class="co-section">
            <h2>Shipping Address</h2>
            <div class="field-row">
              <div class="field"><label for="fname">First Name</label><input type="text" id="fname" required></div>
              <div class="field"><label for="lname">Last Name</label><input type="text" id="lname" required></div>
            </div>
            <div class="field"><label for="addr">Address</label><input type="text" id="addr" required placeholder="Street address"></div>
            <div class="field-row">
              <div class="field"><label for="city">City</label><input type="text" id="city" required></div>
              <div class="field"><label for="zip">ZIP / Postal Code</label><input type="text" id="zip" required></div>
            </div>
            <div class="field-row">
              <div class="field"><label for="country">Country</label>
                <select id="country" required>
                  <option>United States</option><option>Pakistan</option><option>United Kingdom</option><option>Canada</option><option>Other</option>
                </select>
              </div>
              <div class="field"><label for="phone">Phone</label><input type="tel" id="phone" required></div>
            </div>
          </section>

          <section class="co-section">
            <h2>Shipping Method</h2>
            <label class="ship-option active">
              <input type="radio" name="ship" value="0" checked style="display:none;">
              <div><div class="so-name">Standard Shipping</div><div class="so-time">3–6 business days</div></div>
              <div class="so-price">Free</div>
            </label>
            <label class="ship-option">
              <input type="radio" name="ship" value="500" style="display:none;">
              <div><div class="so-name">Express Shipping</div><div class="so-time">1–2 business days</div></div>
              <div class="so-price">Rs. 500</div>
            </label>
          </section>

          <section class="co-section">
            <h2>Payment</h2>
            <div class="field"><label for="cardnum">Card Number</label><input type="text" id="cardnum" placeholder="•••• •••• •••• ••••" required></div>
            <div class="field-row">
              <div class="field"><label for="exp">Expiry</label><input type="text" id="exp" placeholder="MM / YY" required></div>
              <div class="field"><label for="cvc">CVC</label><input type="text" id="cvc" placeholder="•••" required></div>
            </div>
          </section>
        </form>
      </div>

      <!-- Right: summary -->
      <aside class="co-summary">
        <h2>Order Summary</h2>
        <div id="summaryItems"></div>
        <div class="promo-row">
          <input type="text" placeholder="Promo code" id="promoInput">
          <button type="button" id="promoBtn">Apply</button>
        </div>
        <div class="cost-row"><span>Subtotal</span><span id="sumSubtotal">Rs. 0</span></div>
        <div class="cost-row"><span>Shipping</span><span id="sumShipping">Free</span></div>
        <div class="cost-row"><span>Estimated Tax</span><span id="sumTax">Rs. 0</span></div>
        <div class="cost-row total"><span>Total</span><span id="sumTotal">Rs. 0</span></div>
        <button class="btn btn-primary" id="placeOrderBtn" form="checkoutForm">Place Order</button>
      </aside>
    </div>

    <div class="empty-cart" id="emptyCart" style="display:none;">
      <h2>Your Cart Is Empty</h2>
      <p>Add a skin before heading to checkout.</p>
      <a href="index.html#collection" class="btn btn-primary">Shop All Skins</a>
    </div>
  </div>

  <!-- Confirmation state -->
  <div class="confirm-panel" id="confirmPanel">
    <div class="check">✓</div>
    <h1>Order Placed.</h1>
    <p>Thanks — this is where a real confirmation email would land in your inbox.</p>
    <p class="order-id" id="orderIdLine">Order #OWNIT-000000</p>
    <div class="demo-banner"><strong>Portfolio demo.</strong> No real order was created and no payment was charged. This screen exists to show the full flow through to confirmation.</div>
    <a href="index.html" class="btn btn-ghost">Back To Home</a>
  </div>
</main>

<script src="js/cart.js"></script>
<script src="js/assistant.js"></script>
<script>
  const TAX_RATE = 0.0;
  let shippingCost = 0;

  function money(n){ return window.OwnItCart.pkr(n); }

  function renderSummary(){
    const cart = window.OwnItCart.getCart();
    const itemsEl = document.getElementById('summaryItems');
    const coGrid = document.getElementById('coGrid');
    const emptyEl = document.getElementById('emptyCart');

    if (cart.length === 0){
      coGrid.style.display = 'none';
      emptyEl.style.display = 'block';
      return;
    }
    coGrid.style.display = 'grid';
    emptyEl.style.display = 'none';

    itemsEl.innerHTML = cart.map(item => `
      <div class="sum-item">
        <img src="${item.image}" alt="${item.name}">
        <div>
          <div class="sum-item-name">${item.name}</div>
          <div class="sum-item-variant">${item.variant || ''}</div>
          <div class="sum-item-qty">Qty ${item.qty}</div>
        </div>
        <div class="sum-item-price">${money(item.price * item.qty)}</div>
      </div>`).join('');

    const subtotal = window.OwnItCart.cartTotal();
    const tax = subtotal * TAX_RATE;
    const total = subtotal + shippingCost + tax;
    document.getElementById('sumSubtotal').textContent = money(subtotal);
    document.getElementById('sumShipping').textContent = shippingCost === 0 ? 'Free' : money(shippingCost);
    document.getElementById('sumTax').textContent = money(tax);
    document.getElementById('sumTotal').textContent = money(total);
  }

  // Shipping method selection
  document.querySelectorAll('.ship-option').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.ship-option').forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
      opt.querySelector('input').checked = true;
      shippingCost = parseFloat(opt.querySelector('input').value);
      renderSummary();
    });
  });

  document.getElementById('promoBtn').addEventListener('click', () => {
    const btn = document.getElementById('promoBtn');
    const original = btn.textContent;
    btn.textContent = 'No active codes';
    btn.disabled = true;
    setTimeout(() => { btn.textContent = original; btn.disabled = false; }, 1800);
  });

  document.getElementById('checkoutForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const orderId = 'OWNIT-' + Math.floor(100000 + Math.random() * 900000);
    document.getElementById('orderIdLine').textContent = 'Order #' + orderId;
    document.getElementById('coContent').classList.add('hidden');
    document.getElementById('confirmPanel').classList.add('show');
    window.OwnItCart.clearCart();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  renderSummary();
</script>

</body>
</html>
